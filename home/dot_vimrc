" -------------------------------------------------------------------------
" vimrc, circa 2017, by wd. heh.

" remove any existing auto-commands
autocmd!

" settings for my type of terminal
set background=dark
syntax on

" generic text formatting stuff
set tabstop=8
set softtabstop=4
set textwidth=76
set shiftwidth=4
set matchpairs+=<:>
set expandtab

" and stuff to keep syntax highlighting sane
set scrolloff=999
set sidescroll=999

" other settings for editor behavior
set history=100
set showmode
set showcmd
set autoindent
set showmatch

" default text formatting options, basically auto-wrapping for text/comments
" and auto-formatting of lists and paragraphs.
set formatoptions=tcqn

" searching options
set ignorecase
set smartcase
set incsearch
set gdefault

set tags=tags;

" keep swapfiles out of directories
set directory=$HOME/.vim/swapfiles//

" who needs compat?  we also need plugins!
set nocp
filetype plugin on

" -------------------------------------------------------------------------
" settings for omnicppcomplete
let OmniCpp_NamespaceSearch = 2
let OmniCpp_GlobalScopeSearch = 1
let OmniCpp_ShowAccess = 1
let OmniCpp_ShowPrototypeInAbbr = 1 " show function parameters
let OmniCpp_MayCompleteDot = 1 " autocomplete after .
let OmniCpp_MayCompleteArrow = 1 " autocomplete after ->
let OmniCpp_MayCompleteScope = 1 " autocomplete after ::
let OmniCpp_SelectFirstItem = 2 " auto-select first popup (but don't insert)
let OmniCpp_DefaultNamespaces = ["std"]
" automatically open and close the popup menu / preview window
au CursorMovedI,InsertLeave * if pumvisible() == 0|silent! pclose|endif
set completeopt=menuone,menu,preview

" -------------------------------------------------------------------------
" handling for different file types
filetype on

augroup filetype
    autocmd BufNewFile,BufRead /tmp/mutt-* set filetype=mail
    autocmd BufNewFile,BufRead *.txt set filetype=human
    autocmd BufNewFile,BufRead *.md set filetype=markdown
augroup END

autocmd fileType mail,human set textwidth=72 formatoptions+=a

autocmd fileType c,cpp set cindent
autocmd fileType c,cpp set cinoptions=:0(0
autocmd fileType c,cpp,css set formatoptions-=ro

autocmd fileType c,cpp,python,ps1,cs set number
autocmd fileType c,cpp,python,ps1,cs set textwidth=120

autocmd fileType perl,css set smartindent

autocmd fileType make set noexpandtab

autocmd fileType markdown set tw=0
autocmd fileType markdown set syntax=markdown

" -------------------------------------------------------------------------
" syntax highlighting and formatting
" comments
highlight comment ctermfg=darkmagenta

" constants
highlight constant ctermfg=darkcyan
highlight string ctermfg=lightmagenta
highlight character ctermfg=lightmagenta
highlight number ctermfg=darkcyan
highlight boolean ctermfg=darkcyan
highlight float ctermfg=darkcyan

" identifiers (variables)
highlight identifier ctermfg=grey
highlight function ctermfg=darkmagenta

" statements
highlight statement ctermfg=grey
highlight conditional ctermfg=darkmagenta
highlight repeat ctermfg=darkmagenta
highlight label ctermfg=lightcyan
highlight operator ctermfg=lightcyan
highlight keyword ctermfg=darkcyan
highlight exception ctermfg=darkcyan

" preprocessor stuff
highlight preproc ctermfg=darkcyan
highlight include ctermfg=darkcyan
highlight define ctermfg=darkcyan
highlight macro ctermfg=darkcyan
highlight precondit ctermfg=darkcyan

" types
highlight type ctermfg=lightmagenta
highlight storageclass ctermfg=darkmagenta
highlight structure ctermfg=lightmagenta
highlight typedef ctermfg=lightmagenta

" special stuff
highlight special ctermfg=darkcyan
highlight specialchar ctermfg=darkcyan
highlight tag ctermfg=yellow
highlight delimiter ctermfg=darkgrey
highlight specialcomment ctermfg=lightgreen
highlight debug ctermfg=yellow ctermbg=red

" ignore (?)
highlight ignore ctermfg=darkgrey

" errors!
highlight error ctermfg=lightred ctermbg=grey
highlight todo ctermfg=lightgreen

"set comments-=s1:/*,mb:*,ex:*/
"set comments+=s:/*,mb:**,ex:*/
"set comments+=fb:*

"autocmd fileType c,cpp let c_syntax_for_h = 1
"autocmd fileType c,cpp syntax match wd_cDelimiter "[][(),;.{}]" | syntax match wd_cDelimiter "->" | highlight link wd_cDelimiter Delimiter

" -------------------------------------------------------------------------
" keystroke mappings

" make F1 not so damned irritating.
nnoremap <F1> :tab help<Space>
vmap <F1> <C-C><F1>
omap <F1> <C-C><F1>
map! <F1> <C-C><F1>

" use Q for quick reformats
nnoremap Q gqap
vnoremap Q gq

" make indents work in visual mode too
vnoremap <C-T> >
vnoremap <C-D> <LT>
vmap <Tab> <C-T>

" use \tp to toggle pastes, ^p is shorthand for this
"nnoremap \tp :set invpaste paste?<CR>
"nmap <C-P> \tp
"imap <C-P> <C-O>\tp
"set pastetoggle=<C-P>

" toggle list mode
nnoremap \tl :set invlist list?<CR>
nmap <F2> \tl

" toggle highlighting of search matches
nnoremap \th :set invhls hls?<CR>
nmap <F3> \th

" make backspace work the way it does in most other programs
set backspace=eol,start,indent

" 'find tag'
map <F7> :tab tag 

" taglist stuff
nnoremap <silent> <F8> :TlistToggle<CR>
let Tlist_Use_Right_Window = 1
let Tlist_Sort_Type = "name"
let Tlist_GainFocus_On_ToggleOpen = 1
let Tlist_Exit_OnlyWindow = 1
let Tlist_Display_Prototype = 1
let Tlist_Compact_Format = 1


" for c/cpp files use omnicomplete 'cause it's nicer
autocmd fileType c,cpp,css imap <C-N> <C-X><C-O>

