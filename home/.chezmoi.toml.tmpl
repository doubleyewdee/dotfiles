{{- /* asked once at `chezmoi init`; re-ask with `chezmoi init --prompt`, or preset with `--promptBool "Work machine=true"` (keyed by prompt text) */ -}}
{{- $work := promptBoolOnce . "work" "Work machine" false -}}

{{- /* remember where the repo lives so `chezmoi init --source ~/.dotfiles ...` sticks for later commands */ -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    work = {{ $work }}
