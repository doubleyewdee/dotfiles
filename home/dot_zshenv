# ----------------------------------------------------------------------------------------------------------------------
# loaded first for all shells (interactive or otherwise) and useful for setting up any environment variables that you
# expect to "just work" in all shells, interactive or not.

# load homebrew environment if available
if [[ -d /opt/homebrew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -d /home/linuxbrew/.linuxbrew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

typeset -U path

# look for Linux user-mode .NET install in the usual place and bring it in if so
if test -d $HOME/.dotnet && test -x $HOME/.dotnet/dotnet; then
  export DOTNET_ROOT=$HOME/.dotnet
  path+=("$DOTNET_ROOT")
fi
# independently, if `dotnet` is available, look for ~/.dotnet/tools
if (( $+commands[dotnet] )) && test -d $HOME/.dotnet/tools; then
  path+=("$HOME/.dotnet/tools")
fi

if (( $+commands[go] )); then
  export GOPATH="$HOME/.go"
  if [[ ! -d $GOPATH ]]; then
    mkdir -p $GOPATH
  fi
  export PATH="$PATH:$GOPATH"
fi

# ruby gems for adam sandler
if [[ -d $HOME/.gems ]]; then
  export GEM_HOME="$HOME/.gems"
  export PATH="$PATH:$GEM_HOME/bin"
fi

if test -d $HOME/.local/bin; then
  export PATH="$PATH:$HOME/.local/bin"
fi

# depending on host type you might get `dircolors` (gnu coreutils) directly or, for macOS, have `udircolors` via
# uutils-coreutils (the Rust `coreutils` version because, really, GNU kinda sucks and RMS literally eats stuff off his
# feet and I just can't)
if [[ -f $HOME/.dircolors ]]; then
  if (( $+commands[uu-dircolors] )); then
    eval $(uu-dircolors -b $HOME/.dircolors)
  elif (( $+commands[udircolors] )); then
    eval $(udircolors -b $HOME/.dircolors)
  elif (( $+commands[dircolors] )); then
    eval $(dircolors -b $HOME/.dircolors)
  fi
fi

# general fzf options
export FZF_DEFAULT_OPTS='--height 50% --popup bottom,50% --layout reverse --border top'

if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

# ----------------------------------------------------------------------------------------------------------------------------------
# extra layers: chezmoi-managed optional bits (e.g. work.zshenv), then unmanaged per-machine config
for f in $HOME/.config/zsh/*.zshenv(N) $HOME/.zshenv.local(N); do
  source $f
done
unset f
