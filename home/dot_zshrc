# ----------------------------------------------------------------------------------------------------------------------
# loaded after zshenv and zprofile for *any interactive shell*, this is useful for managing prompt configurations,
# aliases, and whatever other "interactive goodies" you desire.

# use starship for the prompt if present
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

# ----------------------------------------------------------------------------------------------------------------------
# set aliases here, before loading omz / setting up completions / etc

# Preferred editor:
# 1. vim/vi as default (as available)
# 2. VS Code in same window if $TERM_PROGRAM is set to 'vscode' (e.g. in a VCSCode terminal or remote session)
# 3. VS Code in new window if not in a remote (ssh) session and VS Code is installed
if (( $+commands[vim] )); then
  export EDITOR=vim
else
  export EDITOR=vi
fi
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
  # reasonable to expect `code` works here since we're in VS Code wrapping $somehow
  export EDITOR='code --wait'
  alias code='code --reuse-window'
elif [[ -z "$SSH_CONNECTION" ]] && (( $+commands[code] )); then
  export EDITOR='code --new-window --wait'
  alias code='code --new-window'
fi
# and add shorthands for VS Code if we're using it
if [[ "$EDITOR" = 'code'* ]]; then
  alias c-='code -'
  alias c='code'
fi
export VISUAL="$EDITOR"
# otherwise I guess just whatever $EDITOR is. /shrug

if (( $+commands[rg] )); then
  alias rg='rg --hidden --smart-case'
  alias sgrep='rg -i --context=2 --color=auto --hidden'
else
  alias sgrep="grep -RIi --context=2 --color=auto --extended-regexp  --exclude-dir={.bzr,CVS,.git,.hg,.svn,obj,objd,bin,build}"
fi
alias sg=sgrep

if [[ -z "$SSH_AUTH_SOCK" && (( $+commands[ssh-add] )) ]]; then
  eval `ssh-agent -s` 2>&1 > /dev/null
fi

alias less='less -R'

# other aliases for lazy bois
alias findi='find . -iname'
alias findn='find . -name'
alias grepi='grep -i'
alias tmpssh='ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
if (( $+commands[fd] )); then
  alias fd='fd --hidden'
fi

# ----------------------------------------------------------------------------------------------------------------------
# OMZ setup here

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$ZSH/custom"

# install omz + plugins if missing
if [[ ! -d $ZSH ]]; then
  sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --keep-zshrc --unattended
  if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]]; then
    git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
  fi
  if [[ ! -d "$ZSH_CUSTOM/plugins/fzf-tab" ]]; then
    git clone https://github.com/Aloxaf/fzf-tab ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/fzf-tab
  fi
  echo
  printf "-%.0s" {1..$COLUMNS}
  echo "Installed Oh-My-Zsh + syntax highlighting + fzf-tab, this probably works? Good luck!"
  echo
  echo
fi

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zshis loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_COLORIZE_STYLE="monokai"
ZSH_COLORIZE_CHROMA_FORMATTER="terminal16m"

# Uncomment the following line to display red dots whilst waiting for completion.
# NOTE: seems to break multiline prompts w/ fzf-tab
# COMPLETION_WAITING_DOTS="true"

# This is the goober that dumps inverted %/# marks when you `cat` a file with no trailing newline.
# I do not like that.
PROMPT_EOL_MARK=''

# always load some default plugins, then conditionally add plugins w/o 1:1 executable to plugin name mappings, and then
# the ones with 1:1 mappings.
plugins=(colorize zsh-syntax-highlighting)

# Plugins that don't directly map to the executable name
(( $+commands[apt] )) && plugins+=(debian)
(( $+commands[az] ))  && plugins+=(azure)

# Plugins with 1:1 executable mappings, plus a special case for fzf
for p in brew docker fzf git dotnet kubectl; do
  if (( $+commands[$p] )); then
    plugins+=("$p")
    [[ "$p" == "fzf" ]] && plugins+=(fzf-tab)
  fi
done

# Conditional for macOS (OSTYPE contains "darwin")
if [[ "${OSTYPE#*darwin}" != "$OSTYPE" ]]; then
  plugins+=(macos)
fi

# User configuration
# The following lines were added by compinstall

zstyle ':completion:*' completer _expand _complete _ignored _approximate
# enables completion into subdirectories (can maybe retire `fdc` below if this does what i want)
zstyle ':completion:*' matcher-list 'r:|/=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
zstyle ':completion:*' max-errors 3
zstyle ':completion:*' menu select=1
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s
zstyle :compinstall filename "$HOME/.zshrc"

# try out file/dir previews in fzf-tab if all the requisite goo is available
if (( $+commands[fzf] )); then
  # use a preview window for suitably wide terminals, note that characters are about half as wide as they are tall
  # (although this varies by font, etc) so just use a pretty simple heuristic here
  # ~21:9 or wider
  if (( ($COLUMNS * 0.5 / $LINES) >= 2.3 )); then
    zstyle ':fzf-tab:*' fzf-flags '--preview-window=right:70%'
  # ~16:9
  elif (( ($COLUMNS * 0.5 / $LINES) >= 1.5 )); then
    zstyle ':fzf-tab:*' fzf-flags '--preview-window=right:50%'
  fi

  if (( $+commands[bat] )) && (( $+commands[uu-ls] )); then
    zstyle ':fzf-tab:complete:*:*' fzf-preview '[[ -d $realpath ]] && uu-ls -1 --color=always $realpath || bat --color=always --style=numbers --line-range=:500 $realpath'
  fi
  if (( $+commands[git] )) && (( $+commands[delta] )); then
    zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview 'git diff --color=always $word | delta'
  fi
fi

# load homebrew completions if available
(( $+commands[brew] )) && FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
# user completion functions, picked up by OMZ's compinit
fpath+=~/.zfunc

autoload -Uz compinit
# End of lines added by compinstall
# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=32767
SAVEHIST=32767
setopt appendhistory incappendhistory autocd extendedglob
unsetopt nomatch auto_removeslash
bindkey -e
# End of lines configured by zsh-newuser-install

source $ZSH/oh-my-zsh.sh
# OMZ forces this back on and it's very rude
unsetopt sharehistory

# XXX: 2025-08-26 OMZ is really pissing me off. it shits itself with uutils-coreutils instead of GNU coreutils, need
# to purge OMZ, but for now just don't use this
# for macOS, if we have uutils-coreutils homebrew package, prefer `uu-ls` over macOS `ls`
# more tweaking, just use uutils coreutils always if available, `uu-ls` is meaningfully distinct enough to
# just grab it
#if [[ "${OSTYPE#*darwin}" != "$OSTYPE" ]] && brew ls --versions uutils-coreutils >/dev/null 2>&1 && (( $+commands[uu-ls] )); then
if (( $+commands[uu-ls] )); then
  alias ls='uu-ls --color=auto --group-directories-first --classify=auto --almost-all'
fi


# ----------------------------------------------------------------------------------------------------------------------------------
# fdc - find a file with a partial name, case-insensitive, if there is a single match open in vs code,
# otherwise display matches (or message if none)
function fdc() {
    if [[ -z "$1" ]]; then
        echo "Usage: fdc <partial_filename>"
        return 1
    fi

    # Use 'fd' if available; otherwise, use 'find'
    if command -v fd >/dev/null 2>&1; then
        # Use 'fd' to find files matching the partial name, case-insensitive
        IFS=$'\n' matches=($(fd -H -t f -i "$1"))
    else
        # Use 'find' to find files matching the partial name, case-insensitive
        IFS=$'\n' matches=($(find -H . -type f -iname "*$1*"))
    fi
    unset IFS

    count=${#matches[@]}

    if [[ $count -eq 0 ]]; then
        echo "No files found matching '$1'"
    elif [[ $count -eq 1 ]]; then
        echo "Opening '${matches[1]}'"
        code "${matches[1]}"
    else
        echo "Multiple files found matching '$1':"
        for file in "${matches[@]}"; do
            echo "$file"
        done
    fi
}

# BEGIN claude-cli MANAGED BLOCK
if [[ -d "$HOME/.claude-cli/CurrentVersion" && ":${PATH}:" != *":$HOME/.claude-cli/CurrentVersion:"* ]]; then
    export PATH="$HOME/.claude-cli/CurrentVersion:${PATH}"
fi
# END claude-cli MANAGED BLOCK
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# ----------------------------------------------------------------------------------------------------------------------------------
# extra layers: chezmoi-managed optional bits (e.g. work.zshrc), then unmanaged per-machine config. tools that want to
# append to ~/.zshrc should go in ~/.zshrc.local instead, since `chezmoi apply` will overwrite ~/.zshrc.
for f in $HOME/.config/zsh/*.zshrc(N) $HOME/.zshrc.local(N); do
  source $f
done
unset f
