# ----------------------------------------------------------------------------------------------------------------------
# loaded after zshenv and zprofile for *any interactive shell*, this is useful for managing prompt configurations,
# aliases, and whatever other "interactive goodies" you desire.

# prefer starship over pl10k if present
if command_exists starship; then
  eval "$(starship init zsh)"
  _NO_PL10K=1
fi

# ----------------------------------------------------------------------------------------------------------------------
# set aliases here, before loading omz / setting up completions / etc

# Preferred editor:
# 1. vim/vi as default (as available)
# 2. VS Code in same window if $TERM_PROGRAM is set to 'vscode' (e.g. in a VCSCode terminal or remote session)
# 3. VS Code in new window if not in a remote (ssh) session and VS Code is installed
if command_exists vim; then
  export EDITOR=vim
else
  export EDITOR=vi
fi
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
  # reasonable to expect `code` works here since we're in VS Code wrapping $somehow
  export EDITOR='code --wait'
  alias code='code --reuse-window'
elif [[ -z "$SSH_CONNECTION" ]] && command_exists code; then
  export EDITOR='code --new-window --wait'
  alias code='code --new-window'
fi
# and add shorthands for VS Code if we're using it
if [[ "$EDITOR" = 'code'* ]]; then
  alias c-='code -'
  alias c='code'
fi
export VISUAL="$EDITOR"
# otherwise I guess just whatever $EDITOR is. /shrug

if command_exists rg; then
  alias rg='rg --hidden --smart-case'
  alias sgrep='rg -i --context=2 --color=auto --hidden'
else
  alias sgrep="grep -RIi --context=2 --color=auto --extended-regexp  --exclude-dir={.bzr,CVS,.git,.hg,.svn,obj,objd,bin,build}"
fi
alias sg=sgrep

if [[ -z "$SSH_AUTH_SOCK" && $(command_exists ssh-add) ]]; then
  eval `ssh-agent -s` 2>&1 > /dev/null
fi

alias less='less -R'

# other aliases for lazy bois
alias findi='find . -iname'
alias findn='find . -name'
alias grepi='grep -i'
alias tmpssh='ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
if command_exists fd; then
  alias fd='fd --hidden'
fi

